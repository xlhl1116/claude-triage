{
  "version": 1,
  "tiers": {
    "quick": {
      "agent": "triage-quick",
      "model": "haiku",
      "effort": "n/a",
      "label_zh": "快速门诊",
      "label_en": "Quick clinic",
      "expected_output_tokens": 600,
      "_note": "Claude Haiku 4.5 has no effort parameter; it is already the fastest tier."
    },
    "standard": {
      "agent": "triage-standard",
      "model": "sonnet",
      "effort": "medium",
      "label_zh": "普通门诊",
      "label_en": "Standard clinic",
      "expected_output_tokens": 2500
    },
    "deep": {
      "agent": "triage-deep",
      "model": "opus",
      "effort": "high",
      "label_zh": "专家门诊",
      "label_en": "Specialist clinic",
      "expected_output_tokens": 8000
    }
  },
  "thresholds": {
    "standard": 2,
    "deep": 5
  },
  "base_context_tokens": 3000,
  "overrides": {
    "quick": [
      "@quick",
      "--quick",
      "@haiku",
      "用haiku",
      "用 haiku",
      "快速回答"
    ],
    "standard": [
      "@standard",
      "--standard",
      "@sonnet",
      "用sonnet",
      "用 sonnet"
    ],
    "deep": [
      "@deep",
      "--deep",
      "@opus",
      "用opus",
      "用 opus",
      "深度思考",
      "ultrathink",
      "think hard"
    ]
  },
  "signals": [
    {
      "id": "chitchat",
      "label_zh": "寒暄/闲聊",
      "label_en": "Chit-chat",
      "weight": -3,
      "patterns": [
        "^\\s*(hi|hello|hey|thanks|thank you|你好|您好|谢谢|早上好|晚安)[\\s!！。.,，]*$"
      ]
    },
    {
      "id": "translate",
      "label_zh": "翻译/润色",
      "label_en": "Translate / polish",
      "weight": -2,
      "patterns": [
        "翻译",
        "译成",
        "\\btranslat",
        "into (english|chinese|japanese)",
        "润色",
        "\\bproofread"
      ]
    },
    {
      "id": "trivial_edit",
      "label_zh": "琐碎修改",
      "label_en": "Trivial edit",
      "weight": -2,
      "patterns": [
        "拼写",
        "错别字",
        "\\btypos?\\b",
        "\\bspelling\\b",
        "改个名",
        "重命名(变量|函数)?",
        "\\brename (this|the|a) (variable|function|file)",
        "格式化",
        "\\bformat (this|the) (json|yaml|code)",
        "大小写",
        "加个?注释",
        "\\badd (a )?comments?\\b"
      ]
    },
    {
      "id": "simple_fact",
      "label_zh": "简单问答",
      "label_en": "Simple lookup",
      "weight": -1,
      "patterns": [
        "^\\s*(什么是|啥是|what is|what's|who is|define|定义)",
        "(是什么意思|什么意思)[?？]?\\s*$",
        "^\\s*how do (i|you) (say|spell)",
        "(怎么读|缩写)"
      ]
    },
    {
      "id": "code_write",
      "label_zh": "编写代码",
      "label_en": "Write code",
      "weight": 2,
      "patterns": [
        "写(一个|个)?(函数|脚本|类|接口|组件|程序|代码)",
        "实现(一个|个)?",
        "\\bimplement\\b",
        "\\bwrite (a|an|the) (\\w+ ){0,2}(function|script|class|component|program|cli|endpoint)",
        "\\bbuild (a|an) "
      ]
    },
    {
      "id": "bug_fix",
      "label_zh": "排查/修复 bug",
      "label_en": "Debug / fix",
      "weight": 2,
      "patterns": [
        "\\bbugs?\\b",
        "报错",
        "异常",
        "\\berror\\b",
        "\\bexception\\b",
        "traceback",
        "stack ?trace",
        "修复",
        "\\bfix\\b",
        "不工作",
        "跑不起来",
        "\\bdoesn'?t work\\b",
        "\\bfails?\\b"
      ]
    },
    {
      "id": "tests",
      "label_zh": "编写测试",
      "label_en": "Write tests",
      "weight": 2,
      "patterns": [
        "单元测试",
        "测试用例",
        "\\bunit tests?\\b",
        "\\bwrite tests?\\b",
        "\\btest cases?\\b"
      ]
    },
    {
      "id": "refactor",
      "label_zh": "重构",
      "label_en": "Refactor",
      "weight": 2,
      "patterns": [
        "重构",
        "\\brefactor",
        "\\bclean ?up\\b",
        "优化(一下)?(这段)?代码"
      ]
    },
    {
      "id": "code_review",
      "label_zh": "代码审查",
      "label_en": "Code review",
      "weight": 2,
      "patterns": [
        "代码审查",
        "审查",
        "\\bcode review\\b",
        "\\breview (this|my|the) (code|pr|diff|change)"
      ]
    },
    {
      "id": "explain_code",
      "label_zh": "解释代码",
      "label_en": "Explain code",
      "weight": 1,
      "patterns": [
        "解释(一下)?(这段)?代码",
        "这段代码",
        "\\bexplain (this|the|what this) (code|function|snippet)",
        "\\bwhat does this (code|function) do\\b"
      ]
    },
    {
      "id": "summarize",
      "label_zh": "总结归纳",
      "label_en": "Summarize",
      "weight": 1,
      "patterns": [
        "总结",
        "概括",
        "摘要",
        "\\bsummari[sz]e\\b",
        "\\btl;?dr\\b"
      ]
    },
    {
      "id": "architecture",
      "label_zh": "架构/系统设计",
      "label_en": "Architecture / system design",
      "weight": 5,
      "patterns": [
        "架构",
        "系统设计",
        "技术选型",
        "微服务",
        "\\barchitect",
        "\\bsystem design\\b",
        "\\bdesign (a|an|the) (system|service|platform|schema|database)",
        "\\bmicroservices?\\b"
      ]
    },
    {
      "id": "tradeoff",
      "label_zh": "方案权衡",
      "label_en": "Trade-off analysis",
      "weight": 2,
      "patterns": [
        "权衡",
        "优缺点",
        "利弊",
        "方案对比",
        "哪个方案",
        "\\btrade-?offs?\\b",
        "\\bpros and cons\\b",
        "\\bcompare (the )?(approaches|options|designs)"
      ]
    },
    {
      "id": "proof",
      "label_zh": "证明/推导",
      "label_en": "Proof / derivation",
      "weight": 5,
      "patterns": [
        "证明",
        "推导",
        "\\bprove\\b",
        "\\bproof\\b",
        "\\bderive\\b",
        "\\blinearizab"
      ]
    },
    {
      "id": "algorithms",
      "label_zh": "算法/复杂度",
      "label_en": "Algorithms / complexity",
      "weight": 2,
      "patterns": [
        "时间复杂度",
        "空间复杂度",
        "复杂度",
        "算法设计",
        "最优解",
        "\\bcomplexity\\b",
        "\\boptimal\\b",
        "\\bnp-hard\\b",
        "\\bdynamic programming\\b",
        "动态规划"
      ]
    },
    {
      "id": "concurrency",
      "label_zh": "并发/分布式",
      "label_en": "Concurrency / distributed",
      "weight": 4,
      "patterns": [
        "并发",
        "竞态",
        "死锁",
        "分布式",
        "一致性",
        "\\bconcurren",
        "\\brace condition",
        "\\bdeadlock",
        "\\bdistributed\\b",
        "\\bconsistency\\b",
        "\\bconsensus\\b"
      ]
    },
    {
      "id": "hard_debug",
      "label_zh": "疑难杂症排查",
      "label_en": "Hard-to-reproduce bug",
      "weight": 5,
      "patterns": [
        "偶发",
        "间歇",
        "偶尔",
        "随机失败",
        "根因",
        "内存泄漏",
        "\\bintermittent",
        "\\bflaky\\b",
        "\\broot cause\\b",
        "\\bmemory leak\\b",
        "\\bheisenbug\\b",
        "\\bonly in production\\b",
        "只在(线上|生产)",
        "\\bleak(s|ing|ed)?\\b",
        "\\bin production\\b",
        "泄漏",
        "泄露"
      ]
    },
    {
      "id": "security",
      "label_zh": "安全审计",
      "label_en": "Security audit",
      "weight": 4,
      "patterns": [
        "安全审计",
        "漏洞",
        "威胁建模",
        "\\bsecurity (audit|review)\\b",
        "\\bvulnerab",
        "\\bthreat model"
      ]
    },
    {
      "id": "performance",
      "label_zh": "性能优化",
      "label_en": "Performance",
      "weight": 2,
      "patterns": [
        "性能",
        "瓶颈",
        "延迟",
        "\\bperformance\\b",
        "\\bbottleneck",
        "\\blatency\\b",
        "\\bprofil(e|ing)\\b"
      ]
    },
    {
      "id": "migration",
      "label_zh": "迁移/重写",
      "label_en": "Migration / rewrite",
      "weight": 2,
      "patterns": [
        "迁移",
        "重写",
        "升级到",
        "\\bmigrat",
        "\\brewrite\\b",
        "\\bport (this|the|it) (to|from)\\b"
      ]
    },
    {
      "id": "multi_file",
      "label_zh": "跨文件/全仓库",
      "label_en": "Multi-file / whole repo",
      "weight": 3,
      "patterns": [
        "整个(项目|仓库|代码库|系统)",
        "全(仓库|项目)",
        "多个文件",
        "所有文件",
        "\\b(entire|whole) (codebase|repo|repository|project)\\b",
        "\\bacross (the )?(codebase|repo|files|modules)\\b",
        "\\bmultiple files\\b"
      ]
    },
    {
      "id": "multi_step",
      "label_zh": "多步骤任务",
      "label_en": "Multi-step task",
      "weight": 1,
      "patterns": [
        "首先.{0,80}然后",
        "第一步",
        "分步",
        "\\bstep[- ]by[- ]step\\b",
        "\\bfirst\\b.{0,80}\\bthen\\b"
      ]
    }
  ],
  "computed": {
    "short_prompt": {
      "label_zh": "请求很短",
      "label_en": "Very short request",
      "weight": -1,
      "max_chars": 40,
      "_note": "only applied when no positive keyword signal matched"
    },
    "has_code": {
      "label_zh": "包含代码",
      "label_en": "Contains code",
      "weight": 1
    },
    "long_input": {
      "label_zh": "输入较长",
      "label_en": "Long input",
      "weight": 1,
      "min_chars": 2000
    },
    "very_long_input": {
      "label_zh": "输入很长",
      "label_en": "Very long input",
      "weight": 2,
      "min_chars": 8000
    },
    "many_requirements": {
      "label_zh": "需求条目多",
      "label_en": "Many requirements",
      "weight": 1,
      "min_items": 5
    }
  }
}
