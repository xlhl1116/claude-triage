    "t4": 4000,
    "t5": 6000,
    "t6": 9000,
    "t7": 12000,
    "t8": 16000
  },
  "modifiers": [
    {
      "id": "scale",
      "label_zh": "规模大",
      "label_en": "Large scope",
      "delta": 1,
      "patterns": [
        "整个(项目|仓库|代码库|系统|工程)",
        "全(仓库|项目|站)",
        "多个(服务|模块|仓库|系统)",
        "(上|几)万行",
        "所有(文件|模块|服务)",
        "\\b(entire|whole) (codebase|repo|repository|project|system)\\b",
        "\\bacross (the )?(codebase|repo|services)\\b",
        "\\bmonorepo\\b"
      ]
    },
    {
      "id": "risk",
      "label_zh": "风险高",
      "label_en": "High stakes",
      "delta": 1,
      "patterns": [
        "生产环境",
        "支付|资金|交易系统",
        "数据迁移",
        "不可(回滚|逆)|无法回滚",
        "正式(发布|上线)|对外发布",
        "(医疗|金融)系统",
        "\\b(in )?production( system| database| environment)?\\b",
        "\\bpayments?\\b",
        "\\birreversible\\b"
      ]
    },
    {
      "id": "hard_constraints",
      "label_zh": "有复杂度或规模约束",
      "label_en": "Hard constraints",
      "delta": 1,
      "patterns": [
        "\\bO\\((n|log)",
        "10\\^\\d",
        "时间限制|复杂度要求|必须在.{0,6}(秒|毫秒)内",
        "\\bmust run in\\b|\\btime limit\\b",
        "\\bP99\\b.{0,6}<|延迟.{0,4}(小于|低于|<)"
      ]
    },
    {
      "id": "vague",
      "label_zh": "需求模糊",
      "label_en": "Open-ended",
      "delta": 1,
      "patterns": [
        "怎么做(比较|才)?好",
        "最佳(方案|实践|做法)",
        "有什么(好的)?(建议|思路|办法)",
        "帮我(看看|想想)(该)?怎么",
        "不知道(该)?怎么",
        "\\bbest way to\\b",
        "\\bwhat would you (suggest|recommend)\\b",
        "\\bnot sure how\\b"
      ]
    },
    {
      "id": "explicit",
      "label_zh": "步骤明确",
      "label_en": "Explicit steps",
      "delta": -1,
      "patterns": [
        "按(照)?(以下|下面|这个|如下)(的)?(步骤|示例|格式|要求)",
        "步骤如下",
        "参照(下面|以下|这个)(的)?(例子|示例)",
        "\\bfollow (these|the following) steps\\b",
        "\\bexactly as (follows|below)\\b"
      ]
    }
  ],
  "computed_modifiers": {
    "long_input": {
      "label_zh": "输入很长",
      "label_en": "Long input",
      "delta": 1,
      "min_chars": 3000
    },
    "many_requirements": {
      "label_zh": "要求条目多",
      "label_en": "Many requirements",
      "delta": 1,
      "min_items": 5
    }
  }
}
